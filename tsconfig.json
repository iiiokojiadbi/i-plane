{
  "compilerOptions": {
    // TypeScript 7: strict, target и module уже имеют разумные умолчания,
    // задаем только то, что отличается от них.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "verbatimModuleSyntax": true,
    // Imports carry the .ts extension so Node can run the sources directly
    // (node --experimental-strip-types) without a build step while debugging.
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
